  "$themes": "主题管理可选的强调色。每个变体只覆盖品牌相关的三个角色，其余角色沿用上面的浅色 / 深色基准；深色值与浅色值分别验证过对比度，不做算法反相（docs/02 §3.4）。primarySubtle 只用于选中底色，浅色下取同色相极浅值，深色下取同色相极深值。",
  "theme": {
    "default": {
      "label": "经典蓝",
      "light": { "primary": "#176BFF", "primarySubtle": "#E0F2FE", "onPrimary": "#FFFFFF" },
      "dark": { "primary": "#3D8BFF", "primarySubtle": "#0E1B2E", "onPrimary": "#FFFFFF" }
    },
    "graphite": {
