# 复制为 .env 后填写。.env 不入库。
# 必填：签名密钥、凭据加密密钥
REX_SECRET_KEY=change-me-in-production
REX_CREDENTIAL_KEY=change-me-in-production

# 可调项
REX_DATABASE_URL=sqlite:///./data/rex.db
REX_ACCESS_TTL_SECONDS=7200
REX_REFRESH_TTL_SECONDS=2592000
REX_SEARCH_TIMEOUT_SECONDS=8
REX_STORAGE_RATE_LIMIT=0
# 访问 115 的出口代理，留空直连。Clash Verge 默认 7897
REX_STORAGE_PROXY=
REX_STATIC_DIR=
REX_CORS_ORIGINS=
REX_MOCK_MODE=1
